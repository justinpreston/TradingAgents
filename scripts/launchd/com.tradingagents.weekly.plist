<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weekly Friday pre-market TradingAgents cadence — ALL TIERS, auto-chained.

  Installs a launchd job that runs scripts/run_weekly_all_tiers.py every
  Friday at 06:30 local time (pre-market, well ahead of the 09:30 ET open),
  with --chain enabled so picks are matrix-run and tradeable the same
  Friday. The wrapper sequentially runs the screener + indexer + diff for
  mid-cap, large-cap, and mega-cap bands, then auto-launches the matrix on
  the top-5 NEW tickers in each tier.

  Sequential (not parallel) by design — on the paid Polygon tier this is no
  longer a rate-limit necessity, just simplicity: each tier's screener
  measured 0.4-2.9 min, and the matrix stage (~21 min/tier) is the actual
  critical path, so 3 tiers chained end-to-end land comfortably before the
  market open even before the 14:00 options-refresh job runs same-day.

  Install:
    cp scripts/launchd/com.tradingagents.weekly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.tradingagents.weekly.plist
    launchctl start com.tradingagents.weekly   # test it once

  Inspect:
    launchctl list | grep tradingagents
    tail -f /Users/jpp5q/Documents/GitHub/TradingAgents/runs/weekly_workflow.log

  Disable:
    launchctl unload ~/Library/LaunchAgents/com.tradingagents.weekly.plist

  EDIT THE PATHS BELOW if you cloned the repo elsewhere or use a different
  username / venv location.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradingagents.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jpp5q/Documents/GitHub/TradingAgents/.venv/bin/python</string>
        <string>/Users/jpp5q/Documents/GitHub/TradingAgents/scripts/run_weekly_all_tiers.py</string>
        <string>--top</string>
        <string>25</string>
        <string>--chain</string>
        <string>--chain-top</string>
        <string>5</string>
        <string>--chain-max-parallel</string>
        <string>5</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jpp5q/Documents/GitHub/TradingAgents</string>

    <!-- Friday at 06:30 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Don't auto-restart on failure (one shot per scheduled fire) -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/jpp5q/Documents/GitHub/TradingAgents/runs/weekly_workflow.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jpp5q/Documents/GitHub/TradingAgents/runs/weekly_workflow.log</string>

    <!-- Environment: ensure .env vars are loaded by the script's own load_dotenv() -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
