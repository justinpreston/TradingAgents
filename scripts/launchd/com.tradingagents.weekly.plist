<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weekly Friday EOD TradingAgents cadence.

  Installs a launchd job that runs scripts/weekly_workflow.py every Friday
  at 17:00 local time (after US market close at 16:00 ET, with buffer for
  Polygon EOD aggs to settle). The job runs the screener + indexer + diff,
  but does NOT auto-chain the matrix (you should review the NEW ticker
  list before spending the LLM cycles).

  Install:
    cp scripts/launchd/com.tradingagents.weekly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.tradingagents.weekly.plist
    launchctl start com.tradingagents.weekly   # test it once

  Inspect:
    launchctl list | grep tradingagents
    tail -f /Users/jpp5q/Documents/GitHub/TradingAgents/runs/weekly_workflow.log

  Disable:
    launchctl unload ~/Library/LaunchAgents/com.tradingagents.weekly.plist

  EDIT THE PATHS BELOW if you cloned the repo elsewhere or use a different
  username / venv location.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradingagents.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/jpp5q/Documents/GitHub/TradingAgents/.venv/bin/python</string>
        <string>/Users/jpp5q/Documents/GitHub/TradingAgents/scripts/weekly_workflow.py</string>
        <string>--top</string>
        <string>25</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jpp5q/Documents/GitHub/TradingAgents</string>

    <!-- Friday at 17:00 local time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>17</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Don't auto-restart on failure (one shot per scheduled fire) -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/jpp5q/Documents/GitHub/TradingAgents/runs/weekly_workflow.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jpp5q/Documents/GitHub/TradingAgents/runs/weekly_workflow.log</string>

    <!-- Environment: ensure .env vars are loaded by the script's own load_dotenv() -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
